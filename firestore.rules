rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // User's followed players subcollection
    match /users/{userId}/followed/{playerId} {
      allow read, write: if isSignedIn();
    }
  }
}
